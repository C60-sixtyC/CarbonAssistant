<Window x:Class="DeskKeeper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大屏桌面助手by C60"
        Width="1360" Height="840"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="24,14">
            <DockPanel>
                <TextBlock Text="大屏桌面助手by C60" FontSize="24" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />
                <TextBlock x:Name="BannerText" DockPanel.Dock="Right" FontSize="18" Foreground="White"
                           VerticalAlignment="Center" TextAlignment="Right" Text="准备就绪"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="BannerScale" ScaleX="1" ScaleY="1" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="1" Margin="16" />

        <Border Grid.Row="2" Background="White" Padding="12">
            <UniformGrid Columns="3">
                <Button x:Name="NavHome" Content="首页" Style="{StaticResource BigButton}" Margin="8,0" Click="OnNavHome" />
                <Button x:Name="NavClean" Content="清理清单" Style="{StaticResource GhostButton}" Margin="8,0" Click="OnNavClean" />
                <Button x:Name="NavSettings" Content="设置" Style="{StaticResource GhostButton}" Margin="8,0" Click="OnNavSettings" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>

