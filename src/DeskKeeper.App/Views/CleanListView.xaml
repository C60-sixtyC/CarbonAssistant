<UserControl x:Class="DeskKeeper.App.Views.CleanListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="全选" Style="{StaticResource GhostButton}" Height="52" MinWidth="120" Margin="0,0,8,0" Click="OnSelectAll" />
                <Button Content="反选" Style="{StaticResource GhostButton}" Height="52" MinWidth="120" Margin="0,0,8,0" Click="OnInvert" />
                <Button Content="只选临时文件" Style="{StaticResource GhostButton}" Height="52" MinWidth="160" Margin="0,0,8,0" Click="OnSelectJunk" />
                <TextBox x:Name="SearchBox" Width="320" Margin="0,0,8,0" TextChanged="OnSearchChanged"
                         ToolTip="输入文件名关键字过滤" />
                <Button Content="重新扫描" Style="{StaticResource BigButton}" Height="52" MinWidth="140" Click="OnRefresh" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="8" Padding="16" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="DryRunBox" Content="空跑（只预览，不执行）" IsChecked="True" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="撤销上次清理" Style="{StaticResource GhostButton}" Height="72" Margin="16,0" Click="OnRestore" />
                <TextBlock x:Name="SummaryText" Grid.Column="2" VerticalAlignment="Center" Margin="16,0" Style="{StaticResource SecondaryText}" />
                <Button Grid.Column="3" x:Name="ExecuteButton" Content="开始清理" Style="{StaticResource DangerButton}" Height="88" MinWidth="240" Click="OnExecute" />
            </Grid>
        </Border>

        <ListView x:Name="ItemList" Background="White" BorderThickness="0" SelectionMode="Single"
                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Cursor" Value="Hand" />
                            <EventSetter Event="Click" Handler="OnHeaderClick" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Header="" Width="64">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="文件名" Width="260" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="类型" Width="110" DisplayMemberBinding="{Binding KindLabel}" />
                    <GridViewColumn Header="大小" Width="120" DisplayMemberBinding="{Binding SizeLabel}" />
                    <GridViewColumn Header="最后修改" Width="170" DisplayMemberBinding="{Binding ModifiedLabel}" />
                    <GridViewColumn Header="命中原因" Width="280" DisplayMemberBinding="{Binding Reason}" />
                    <GridViewColumn Header="去向" Width="140" DisplayMemberBinding="{Binding DisposalLabel}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>

